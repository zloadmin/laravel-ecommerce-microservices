{
    "name": "ecommerce/shared",
    "description": "Cross-cutting infrastructure shared by all services. No business logic.",
    "type": "library",
    "license": "MIT",
    "require": {
        "firebase/php-jwt": "^7.0",
        "illuminate/auth": "^13.0",
        "illuminate/console": "^13.0",
        "illuminate/contracts": "^13.0",
        "illuminate/database": "^13.0",
        "illuminate/http": "^13.0",
        "illuminate/routing": "^13.0",
        "illuminate/support": "^13.0",
        "php": "^8.3",
        "php-amqplib/php-amqplib": "^3.7"
    },
    "autoload": {
        "psr-4": {
            "Ecommerce\\Shared\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Ecommerce\\Shared\\SharedServiceProvider"
            ]
        }
    },
    "require-dev": {
        "orchestra/testbench": "^11.0",
        "phpunit/phpunit": "^12.5"
    },
    "autoload-dev": {
        "psr-4": {
            "Ecommerce\\Shared\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true
    }
}
