APP_NAME=cart
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://cart:8080

LOG_CHANNEL=stderr
LOG_LEVEL=debug

# Carts live in Redis (through the cache store); there is no database.
SESSION_DRIVER=array
QUEUE_CONNECTION=sync
CACHE_STORE=redis

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PORT=6379

CATALOG_SERVICE_URL=http://catalog:8080
ORDERS_SERVICE_URL=http://orders:8080
CART_TTL_DAYS=30
