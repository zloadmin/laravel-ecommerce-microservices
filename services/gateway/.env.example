APP_NAME=gateway
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8080

LOG_CHANNEL=stderr
LOG_LEVEL=debug

# The gateway is stateless: no database, sessions or queues.
SESSION_DRIVER=array
QUEUE_CONNECTION=sync
CACHE_STORE=redis

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PORT=6379

AUTH_SERVICE_URL=http://auth:8080
CATALOG_SERVICE_URL=http://catalog:8080
ORDERS_SERVICE_URL=http://orders:8080
CART_SERVICE_URL=http://cart:8080

GATEWAY_RATE_LIMIT=120
GATEWAY_CONNECT_TIMEOUT=2
GATEWAY_TIMEOUT=10
